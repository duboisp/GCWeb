					"text",
					"link"
				}
				"privacyUrl", // with default
				"termsUrl" // with default
			],
			"dependencies": "none",
			"files": "../assets/landscape.png",


			"rdfs:comments": "Was identified as v4.0.0",
			"previous": 3
		},
